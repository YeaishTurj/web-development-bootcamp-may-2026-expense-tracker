generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Float
  category    String
  note        String?
  createdAt   DateTime @default(now())

  userId      String
}
