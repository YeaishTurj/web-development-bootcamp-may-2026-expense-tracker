# Spendwise — Example environment variables

# IMPORTANT:
# - Do NOT commit real secrets. This file shows placeholder values and
#   the shape of variables required to run the app locally and on platforms
#   like Vercel. Copy to `.env.local` or `.env` and fill with real values.

# =========================
# DATABASE (Prisma + Supabase)
# =========================
# Example Postgres connection string. Replace USER, PASSWORD, HOST and DATABASE.
# Example formats:
# - Full URL: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# - When using Supabase, use the provided connection string from your project
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Direct URL (optional) for certain Prisma operations (e.g. using a connection pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE"

# =========================
# SUPABASE (Frontend Auth)
# =========================
# Public (anon) keys used by client-side code. Safe-ish to expose, but
# treat them as environment configuration — do not paste service role keys here.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Optional: server-side service role key (ONLY set on server, never in client)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =========================
# APP / NEXT.JS
# =========================
# When deploying, set the public site URL so Supabase redirect links land correctly.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# (Optional) If you use any provider that needs a NEXTAUTH_URL or similar, set it here
# NEXTAUTH_URL="http://localhost:3000"

# =========================
# NOTES
# =========================
# - Copy this file to `.env.local` or `.env` and replace placeholder values.
# - Prisma: if you run Prisma commands, ensure env is loaded (Prisma docs).
# - Supabase: configure email templates and site URL in the Supabase dashboard
#   so password reset and confirmation links use the correct redirect URL.

